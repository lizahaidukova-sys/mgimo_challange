# Скопируйте в .env и заполните. Значения в репозиторий не попадают.

# Секрет подписи сессионной cookie. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# Путь к файлу базы. По умолчанию ./data/app.db
DATABASE_PATH=./data/app.db

# Каталог вложений заявок (сканы справок). По умолчанию ./data/attachments
ATTACHMENTS_DIR=

# Опционально: формулировка объяснений ИИ-помощника.
# Без ключа приложение работает на детерминированных шаблонах.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Публичный адрес прототипа. Пусто — проверка Origin идёт по хосту запроса.
# На сервере укажите фактический адрес: https://dean.example.ru (тогда cookie Secure)
# или http://IP:8787, если TLS ещё нет — тогда cookie без Secure.
APP_ORIGIN=
